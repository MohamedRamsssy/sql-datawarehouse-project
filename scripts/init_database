--first step in the project is to build the database structre and schemas and this steps shows you how to .
-----------------------------------------------------

-- first Building a brand new database and name it 

USE master
	create database datawarehouse 

-- Afer this we build a schemas from scratch 

USE datawarehouse;

GO
	create schema Bronze ;
	
	GO
	create schema Silver;

	GO
	create schema Gold;

	GO
